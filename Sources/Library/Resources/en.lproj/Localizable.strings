/* Menu item that opens the About panel. */
"About Library" = "About Library";

/* Clipboard menu item that empties the clipboard history. */
"Clear History" = "Clear History";

/* Clipboard submenu title and the Clipboard settings tab. */
"Clipboard" = "Clipboard";

/* Menu item that opens the window for editing the library. */
"Edit Library…" = "Edit Library…";

/* Menu item that locks the pinned clipboard items again, so Touch ID or the password is asked for next time. */
"Lock Pinned Items" = "Lock Pinned Items";

/* Button in Quick Open that asks for Touch ID or the password to show a locked pinned clipboard item. */
"Show Pinned Item" = "Show Pinned Item";

/* The title shown in place of a pinned clipboard item's text while it is locked. */
"Pinned Item" = "Pinned Item";

/* Reason shown in the Touch ID or password prompt, after "Use Touch ID or enter your password to". */
"view a pinned clipboard item" = "view a pinned clipboard item";

/* Reason shown in the Touch ID or password prompt, after "Use Touch ID or enter your password to". */
"copy a pinned clipboard item" = "copy a pinned clipboard item";

/* Alert title when the clipboard lock is turned on but the Mac has no Touch ID or password. */
"Set a Mac Password to Lock Clipboard Items" = "Set a Mac Password to Lock Clipboard Items";

/* Alert text when the clipboard lock is turned on but the Mac has no Touch ID or password. */
"Clipboard lock uses Touch ID or your Mac password. Add a password in System Settings, then turn this on again." = "Clipboard lock uses Touch ID or your Mac password. Add a password in System Settings, then turn this on again.";

/* Alert button that opens the Users & Groups pane of System Settings, where a Mac password can be added. */
"Open Users & Groups" = "Open Users & Groups";

/* Alert title when a locked pinned clipboard item is asked for but Touch ID and the Mac password are not available. */
"Clipboard Items Can’t Be Unlocked" = "Clipboard Items Can’t Be Unlocked";

/* Alert text when a locked pinned clipboard item is asked for but Touch ID and the Mac password are not available. */
"Touch ID and your Mac password are not available, so pinned items stay locked. Turn off the lock to show them." = "Touch ID and your Mac password are not available, so pinned items stay locked. Turn off the lock to show them.";

/* Alert button that turns off the clipboard lock, which unlocks the pinned clipboard items. */
"Turn Off Lock" = "Turn Off Lock";

/* Alert button that dismisses a clipboard lock alert without changing anything. */
"Cancel" = "Cancel";

/* Settings tab for general options. */
"General" = "General";

/* Disabled menu item shown when the clipboard history is empty. */
"No Clipboard History" = "No Clipboard History";

/* Toggle that starts Library when the user logs in. */
"Open at Login" = "Open at Login";

/* Menu item that quits the app. */
"Quit Library" = "Quit Library";

/* Menu item that opens the Settings window. */
"Settings…" = "Settings…";

/* Settings tab for keyboard shortcuts. */
"Shortcuts" = "Shortcuts";

/* Menu item that checks GitHub for a newer version of Library. */
"Check for Updates…" = "Check for Updates…";

/* Settings toggle that checks GitHub for a newer version every hour while Library runs. */
"Check for Updates Automatically" = "Check for Updates Automatically";

/* Menu item at the top of the Library menu when a newer version exists. The argument is the version number. */
"Update Available — Version %@" = "Update Available — Version %@";

/* Quick Open action that opens the ways to copy a text clip rewritten. */
"Copy as…" = "Copy as…";

/* Copy as menu item that copies the text unchanged, as plain text. */
"Plain Text" = "Plain Text";

/* Copy as menu item that removes spaces and line breaks at both ends. */
"Trimmed Whitespace" = "Trimmed Whitespace";

/* Copy as menu item that copies the text in lowercase. */
"Lowercase" = "Lowercase";

/* Copy as menu item that copies the text in uppercase. */
"Uppercase" = "Uppercase";

/* Copy as menu item that turns each line break into a space. */
"Joined Lines" = "Joined Lines";

/* Quick Open action, shown for a text clip with an address, that opens the address in Apple Maps. */
"Open in Maps" = "Open in Maps";

/* Quick Open action, shown for a text clip with a phone number, that copies the number with its digits and plus sign only. */
"Copy Phone Number" = "Copy Phone Number";

/* Quick Open action, shown for a text clip with a date or time, that opens the event in Calendar's add-event sheet. */
"Add to Calendar" = "Add to Calendar";

/* Quick Open action that copies a bookmark or link as a Markdown link, [Title](url). */
"Copy as Markdown Link" = "Copy as Markdown Link";

/* Quick Open action that adds a clip to the queue of clips to paste one at a time. */
"Add to Paste Queue" = "Add to Paste Queue";

/* Clipboard menu section title with the number of clips waiting in the paste queue. */
"Paste Queue (%lld)" = "Paste Queue (%lld)";

/* Clipboard menu item that copies the next clip in the paste queue and removes it from the queue. */
"Paste Next" = "Paste Next";

